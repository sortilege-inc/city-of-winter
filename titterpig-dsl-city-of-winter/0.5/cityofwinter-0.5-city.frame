    #COWcab0d3884efc94ac40747 ^"Transit Distance" DEF {
        DESCRIPTION "(# of Stations + Line Transfers between Locations.)"
        COLUMNS [ "Ascending the Spire", "Archipelago", "Arcanium of Brass", "the Dust", "the Drift", "Five Temples", "Forest of the Spire", "Glasstown", "Glowtown", "High Lake", "Holy Well", "Husk", "Invisible Town", "Lantern Gate", "Moonspire Ward", "Palace of the Moon", "the Refuge", "Spiral Avenue", "Undertown" ]
        ROWS {
            ROW "Ascending the Spire" [ "-", "1", "3", "5", "2", "5", "1", "3", "7+", "3", "4", "7+", "3", "6", "1", "4", "7+", "4", "7+" ]
            ROW "Archipelago" [ "1", "-", "5", "3", "1", "5", "3", "5", "6", "2", "3", "7+", "5", "6", "3", "5", "7+", "5", "7+" ]
            ROW "Arcanium of Brass" [ "3", "5", "-", "3", "3", "2", "4", "6", "4", "5", "1", "6", "3", "5", "1", "7+", "7+", "4", "5" ]
            ROW "the Dust" [ "5", "3", "3", "-", "2", "3", "7+", "7+", "1", "4", "1", "3", "3", "2", "4", "7+", "4", "1", "2" ]
            ROW "the Drift" [ "2", "1", "3", "2", "-", "3", "4", "4", "4", "1", "1", "6", "5", "4", "4", "4", "6", "3", "5" ]
            ROW "Five Temples" [ "5", "5", "2", "3", "3", "-", "6", "7+", "1", "5", "1", "3", "5", "5", "3", "7+", "6", "4", "2" ]
