    # ====================================================================
    # GUIDANCE — the rulebook's sidebars and advice
    # ====================================================================

    GUIDANCE {
        ENTRY ^"campaign-vs-one-shot" #COWae99172fea203401246be {
            CONCERNS [ #COWb35380f5379539b870c1b ^"Session" ]
            TOPICS [ "campaign structure" ]
            TEXT "A game can last just one session. This is called a one-shot and is a great way to experience City of Winter for the first time.\n\nDuring a one-shot, our group will create a family, explore their traditions of their homeland, and possibly begin our migration journey.\n\nCity of Winter may also be played as an ongoing campaign lasting many sessions.\n\nDuring a campaign, we follow a family as they migrate from their home to the City of Winter, and explore how their Traditions change as generations pass."
        }
        ENTRY ^"learning-city-of-winter" #COWddad829b917a248bf4b7c {
            CONCERNS [ #COWf668032897eb1f4c8f165 ^"Facilitator" ]
            TOPICS [ "teaching the game" ]
            TEXT "If you are facilitating, familiarize yourself with these rules in advance. It’s ok to not have everything memorized, just make sure you know where to look things up when there are questions."
        }
        ENTRY ^"tradition-banners-in-play" #COW586847691edad1eeac9bf {
            CONCERNS [ #COW58c97a0996410827e972d ^"Tradition Banner" ]
            TOPICS [ "side characters" ]
            TEXT "As we travel, we will encounter different traditions. Each of the traditions we encounter has a Banner with a list of name prompts. Use these prompts to inspire other characters we meet in our story. You can keep Cards and Banners in the box when not in use."
        }
        ENTRY ^"keep-cards-face-down" #COW9dcaf6501b42928951812 {
            CONCERNS [ #COW340430629a9c9ddf85b8f ^"Tradition Card" ]
            TOPICS [ "table procedure" ]
            TEXT "Our Hands of Tradition Cards are not secret, but should be kept in hand or face-down on the table when not in use."
        }
        ENTRY ^"placing-a-token-on-a-location" #COWab43af1fe31ba46578d47 {
            CONCERNS [ #COWd2acafbaab4957949a348 ^"Token" ]
            TOPICS [ "table procedure" ]
            TEXT "When the game asks us to place a token on our Home (or any other location), we place the token on the illustration beneath the name of that Location.\n\nThis is different from placing a Token on a Scene, which refers to written scene prompts that surround each Location.\n\nStarting with the Tokens on the illustration, and not on the Scenes, helps us keep track of who has already taken a turn."
        }
        ENTRY ^"side-characters" #COWe1a453ebc7f9c83146aa8 {
            CONCERNS [ #COWbcf2cb02323d31288006e ^"Side Character" ]
            TOPICS [ "roleplaying" ]
            TEXT "While the focus of our story will be on our main characters, Side-Characters will naturally emerge through play. Everyone is welcome to describe or roleplay a side-character in a scene."
        }
        ENTRY ^"chapters-and-pacing" #COW88d1d25082ffaff869d7d {
            CONCERNS [ #COWfcc9995e7bd1df781c46a ^"Chapter" ]
            TOPICS [ "pacing" ]
            TEXT "We can control the pace of our story by how many Chapters we play in a session. The recommendation is to play a minimum of one Chapter per Session, but you might want to let a Chapter stretch out a couple of Sessions, depending on what is happening in your story.\n\nIf we are in the middle of the Migration Scene procedure, we must complete it before ending the Chapter."
        }
        ENTRY ^"side-characters-and-age" #COWae8e7acdea9f4c3f9460a {
            CONCERNS [ #COWbcf2cb02323d31288006e ^"Side Character" ]
            TOPICS [ "campaign advice" ]
            TEXT "If you are planning to play many Chapters, track the age of Side-Characters you’ve Bonded with on your Notecard. When you start a new Chapter, you can roll for Side-Characters who are Elders, the same as you would for your main character."
        }
        ENTRY ^"widows-and-orphans" #COW0ad977746c6c6f8227306 {
            CONCERNS [ #COW712f1f579806f60d7898f ^"Bond" ]
            TOPICS [ "campaign advice" ]
            TEXT "Some of the Bonds imply that the other character is dead. You can make these Bonds with other main characters if the other player is willing. Likewise, it is okay to decide during the First-Session setup that a character is dead, and play them as a Memory for the first chapter.\n\nWhen this happens, they still receive Traditions during the Hold Tradition step, as normal."
        }
        ENTRY ^"other-ways-to-die" #COWf7b81ee42822783f57658 {
            CONCERNS [ #COW6a7b002765e49a0e3ce44 ^"Memory" ]
            TOPICS [ "campaign advice" ]
            TEXT "Sometimes it makes sense in the story for your character to die. Perhaps something comes up in a scene, or you just feel like it is time.\n\nWhatever the case, you always decide what happens to your main character; this includes death."
        }
        ENTRY ^"leaving-mid-game" #COW8b4c7a52b739e6b7f017f {
            CONCERNS [ #COW1dd4fd9f091792c9b2980 ^"Main Character" ]
            TOPICS [ "campaign advice" ]
            TEXT "If a player ever needs to leave a campaign or session in-progress, transition their character to a side character and add their Tradition Cards to the pool next time we Migrate the Family or end a Chapter."
        }
        ENTRY ^"ending-a-campaign" #COW875ce702b4d15cd693c8c {
            CONCERNS [ #COW0d05ebd3dcc876d3b8fcb ^"Campaign" ]
            TOPICS [ "campaign advice" ]
            TEXT "City of Winter does not have a pre-planned end goal. The stories of our characters end when they die, but the story of our family can continue for as long as we wish to explore it.\n\nWhen the group is ready for the Campaign to end, open up the river scroll and remember our family’s journey as part of the Closing Reflection after the last Session."
        }
        ENTRY ^"rejoining-as-children" #COW2d8bc7d3405555f449c42 {
            CONCERNS [ #COW28b2afcf10a8994ce0e81 ^"Birth" ]
            TOPICS [ "campaign advice" ]
            TEXT "As we play City of Winter, we create a world that is unique to our game. By joining our campaign as a Child, the new player experience aligns with the experience of their character who is also new to our world."
        }
        ENTRY ^"role-juggling" #COW45ae39ee0f2163bec252a {
            CONCERNS [ #COWc3f9ee44050ccdbc64043 ^"Witness a Tradition" ]
            TOPICS [ "table procedure" ]
            TEXT "Juggling lots of roles in one scene can be a challenge. If possible, it is best not to ask a player to roleplay both the local traditions and their own character in the same scene."
        }
        ENTRY ^"different-homes" #COWd5aea823000489e63c476 {
            CONCERNS [ #COW53f9c467842659b045a58 ^"Migrate apart" ]
            TOPICS [ "city rules" ]
            TEXT "While living apart, Migration mechanics affect each group separately. For example, you can Save Traditions left by a family member only if they currently share a Home."
        }
        ENTRY ^"fate-advice" #COW2a55e14c9f782d7ae53f9 {
            CONCERNS [ #COW7539a19476269ba4e60f2 ^"Ask Fate" ]
            TOPICS [ "design notes" ]
            TEXT "- If someone has a good idea for what should happen, just go with that, no need to roll.\n\n- Outcomes should drive the story forward.\n\n- If you’re not interested in something happening in the story, don’t set it as an outcome.\n\n- Go a little deeper than just failure or success to drive the story forward. What are the consequences of that failure or success?\n\n- When setting a Fateful Outcome, don’t be afraid to think big!"
        }
        ENTRY ^"plan-for-a-longer-setup" #COW98790896897ba3b8e1533 {
            CONCERNS [ #COWb5d0482b09d17a27174fb ^"Starting in the City" ]
            TOPICS [ "design notes" ]
            TEXT "The City is a lot to take in all at once. Ten Tradition Decks, transit mechanics, and prompts that are more weird and abstract. The River Scroll gives us a chance to slowly ease into the world with more familiar fantasy themes and mechanics that build bit by bit. If you are running a City game for new players, expect to spend more time explaining the city mechanics."
        }
        ENTRY ^"bullet-journaling" #COW7827b21e61abfb0ec4e9c {
            CONCERNS [ #COW593f9314f909dd6cdaae7 ^"Solo Play" ]
            TOPICS [ "design notes" ]
            TEXT "The method of journaling presented here is adapted from Ryder Carroll’s “Bullet Journal” method."
        }
        ENTRY ^"adding-a-module" #COW57e1c608f3a3ea2869c6d {
            CONCERNS [ #COW593f9314f909dd6cdaae7 ^"Solo Play" ]
            TOPICS [ "solo play" ]
            TEXT "Whenever you add more modules to your journal, turn to the next available blank spread and add the title of that module to the top left corner, number the pages, and enter it into your index.\n\nAlways give yourself a minimum of 1 full spread (2 pages)for each new module."
        }
        ENTRY ^"extending-a-module" #COW5d12c45aac7f5e0b4cab1 {
            CONCERNS [ #COW593f9314f909dd6cdaae7 ^"Solo Play" ]
            TOPICS [ "solo play" ]
            TEXT "If you run out of space in a module, turn to the next blank spread in your journal and continue the module there, indexing as you go."
        }
        ENTRY ^"promoting-a-side-character" #COW1345bd1eda22cf2d90646 {
            CONCERNS [ #COWbcf2cb02323d31288006e ^"Side Character" ]
            TOPICS [ "solo play" ]
            TEXT "At the end of a Chapter, you may promote a side character to a main character. To do this, create a new Main Character Module and transfer your Side-Character’s information to the module."
        }
        ENTRY ^"combined-play" #COW715bd6fcba17204ac2f28 {
            CONCERNS [ #COW593f9314f909dd6cdaae7 ^"Solo Play" ]
            TOPICS [ "solo play" ]
            TEXT "You can mix solo and group play.\n\nInviting a guest\n\nInvite another player as a guest for a session of your solo game.\n\nDuring scenes, assign them the role of side characters, or ask them to take on the role of the locals during your Witness scenes.\n\nAssign them characters and roles for parts of the story that you don’t know much about so they have space to create without worrying about conflicting with your backstory.\n\nBreaking off of a group Campaign\n\nYou could break off a part of an existing group campaign as a solo campaign. Perhaps use this as a way to develop the story of a side character who was left behind, or explore what happened in the years between Chapters of your campaign."
        }
        ENTRY ^"journal-setup" #COWe7e9a11d55d1679893c31 {
            CONCERNS [ #COW593f9314f909dd6cdaae7 ^"Solo Play" ]
            TOPICS [ "solo play" ]
            TEXT "I recommend choosing a journal with an elastic band and a couple of bookmarks."
        }
        ENTRY ^"solo-first-session" #COWbde7b3274379cb375b18e {
            CONCERNS [ #COWc15f03954398235e07d0e ^"Main Character Module" ]
            TOPICS [ "solo play" ]
            TEXT "I recommend just creating one main character for the first session and letting things grow organically from there. This character, and the two side characters they are Bonded with, will be your starting characters in the story."
        }
        ENTRY ^"solo-holding-traditions" #COW8d659e3e318d7f1dd4c54 {
            CONCERNS [ #COWc15f03954398235e07d0e ^"Main Character Module" ]
            TOPICS [ "solo play" ]
            TEXT "Between sessions of play, tuck Traditions held by this character into the pages of their Main Character Module."
        }
        ENTRY ^"by-ship-or-by-caravan" #COW606ddfbfafda6fac468e7 {
            CONCERNS [ #COW441b63f83083926d0c5ab ^"River Scroll", #COWf536cfa3e835f947b7d54 ^"Migrate the Family" ]
            TOPICS [ "atlas" ]
            TEXT "Some Locations have two versions depending if we are traveling by Caravan or by Lantern Ship.\n\nThe Lantern Ship route is indicated by a dashed line and a Lantern Ship icon. The Caravan route is indicated by a Caravan icon and a blue line.\n\nMake sure you are on the page for the correct version when you Migrate to these Locations."
        }
        ENTRY ^"moving-character-tokens-in-the-city" #COWa63206ec8d3296079af44 {
            CONCERNS [ #COWd2acafbaab4957949a348 ^"Token" ]
            TOPICS [ "atlas" ]
            TEXT "In the City, you will find it necessary to flip through the Atlas frequently as we explore different Locations on our turns.\n\nWhen your campaign gets to this point, it is better to place your Token next to the Atlas rather than on the Atlas when choosing a Scene. This allows us to pick up the Atlas and change Locations without having to disturb the other player’s tokens."
        }
    }


    # ====================================================================
    # HOOKS — narrative situations with a mechanical consequence
    # ====================================================================

    HOOKS {
        HOOK #COW0eef1d535aa0510b86135 {
            FORMALITY CONDITIONAL
            WHEN "an Elder character (six Marks of Age) begins a new Chapter"
            TRIGGER { ANY [ "elder at start of chapter" ] }
            THEN [ #COW65682771d95ddb8ec54b2 ^"When You Die" ]
        }
        HOOK #COW0f7bc9c750588d4ad7889 {
            FORMALITY CONDITIONAL
            WHEN "your character gains a Mark at the end of a Chapter"
            TRIGGER { ANY [ "mark gained at end of chapter" ] }
            THEN [ #COW712f1f579806f60d7898f ^"Bond" ]
        }
        HOOK #COWf875ebe63356a845e60f8 {
            FORMALITY CONDITIONAL
            WHEN "“The Borough Wanders” card is drawn and revealed from a Tradition Deck"
            TRIGGER { ANY [ "the borough wanders drawn" ] }
            THEN [ #COW8cef6be761d90b3fdcada ^"The Wandering Borough" ]
        }
        HOOK #COW52aae73c54099b376e9e1 {
            FORMALITY CONDITIONAL
            WHEN "The Wandering Borough is home to one of our characters, at the start of each Chapter and whenever “The Borough Wanders” card is drawn"
            TRIGGER { ANY [ "borough is a home", "the borough wanders drawn" ] }
            THEN [ #COW19c78a942295c6cb68d36 ^"Living on the Borough" ]
        }
        HOOK #COW5ceffcaff6414446f5e2c {
            FORMALITY CONDITIONAL
            WHEN "a Memory character has shared their last Tradition Card"
            TRIGGER { ANY [ "memory hand empty" ] }
            THEN [ #COW31b59e6292f5559e36a1f ^"Becoming forgotten", #COW28b2afcf10a8994ce0e81 ^"Birth" ]
        }
        HOOK #COW381e642c30cd68d3a71ad {
            FORMALITY TAGGED
            WHEN "the family Migrates to one of the five entrances to the City of Winter"
            THEN [ #COWf8c329dee6033fc754a98 ^"Migrating to the City" ]
        }
        HOOK #COW94cf3125ca764243abbc8 {
            FORMALITY TAGGED
            WHEN "our family’s Home is in the City of Winter and we Mark Age"
            THEN [ #COW1d67848dae70cef1f61f7 ^"City Marks" ]
        }
        HOOK #COW757925debe0c199389dd4 {
            FORMALITY PROSE
            WHEN "a question arises that no one wants to answer"
            THEN [ #COW7539a19476269ba4e60f2 ^"Ask Fate" ]
        }
    }
}
