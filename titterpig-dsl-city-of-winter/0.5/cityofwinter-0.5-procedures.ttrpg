EXTENSION "CityOfWinter_Procedures" EXTENDS "CityOfWinter_Core_Base" {
    NAME "City of Winter — procedures, rules, guidance and variants"
    VERSION "0.5"
    SPEC_VERSION "0.5"
    RELEASE_DATE "2026-08-12"

    # Every DESCRIPTION and TEXT below is the rulebook's own wording, verbatim.

    # ====================================================================
    # PROCEDURES
    # ====================================================================

    #COW840989c188c124fea0c4d ^"First Session Setup" DEF {
        EXTENDS #COWdd203f5d990a61b496a78 ^"Procedure"
        PROPERTIES {
            ^"Phase" STRING "First Session Setup"
            ^"Page" INTEGER 10
        }
        STEPS {
            #COW6b4acd942ba5b981f97e6 ^"First Session Setup: Introduction" DEF {
                EXTENDS #COW2a7a9356dd70402814e37 ^"Step"
                PROPERTIES {
                    ^"Order" INTEGER 1
                }
                DESCRIPTION "Take turns reading these paragraphs out loud:"
                STEPS {
                    #COWa2316f070bab3e636dc38 ^"First Session Setup: Introduction: Roleplaying" DEF {
                        EXTENDS #COW2a7a9356dd70402814e37 ^"Step"
                        PROPERTIES {
                            ^"Order" INTEGER 1
                        }
                        TEACHING_TEXT "In City of Winter, we each take on the role of a different member of a family. There are many ways to roleplay. We might talk casually, like in a conversation, narrate as authors, perform as actors, or mix several styles all at once. Do whatever feels natural, or challenge yourself to try something new."
                    }
                    #COWa9b12f70e82f460d19da1 ^"First Session Setup: Introduction: Group Storytelling" DEF {
                        EXTENDS #COW2a7a9356dd70402814e37 ^"Step"
                        PROPERTIES {
                            ^"Order" INTEGER 2
                        }
                        TEACHING_TEXT "As we tell the story, we sometimes step outside of our own characters to describe the world around them, what is going on, or roleplay side-characters that emerge in a scene.\n\nWe are both writers in the writing room, and fans in the audience. Feel free to converse, share ideas, or just wonder aloud about anything that interests you as we play."
                    }
                    #COW16fa484dc235b5c91ddd0 ^"First Session Setup: Introduction: Think small" DEF {
                        EXTENDS #COW2a7a9356dd70402814e37 ^"Step"
                        PROPERTIES {
                            ^"Order" INTEGER 3
                        }
                        TEACHING_TEXT "When it is time to make something up, think small and don’t plan too far ahead. Let the story be a wondrous beast we chase but never capture. Ask questions with no clear answer, raise conflicts with no ready solution. By letting go, the story we find together will be more profound than anything we might have planned alone."
                    }
                    #COWbcf0a3eb115651d995149 ^"First Session Setup: Introduction: Safety and the X-Card" DEF {
                        EXTENDS #COW2a7a9356dd70402814e37 ^"Step"
                        PROPERTIES {
                            ^"Order" INTEGER 4
                        }
                        TEACHING_TEXT "The X-Card is a safety tool. It reminds us that we all have the power to remove anything from the story that is making us feel uncomfortable, or spoiling our fun. To do so, simply tap this card, or say ‘I’d like to X card that,’ and we’ll find another way to tell our story. No questions asked."
                    }
                }
            }
            #COW133a920e14642ef2169f7 ^"First Session Setup: Choose Home & Tradition" DEF {
                EXTENDS #COW2a7a9356dd70402814e37 ^"Step"
                PROPERTIES {
                    ^"Order" INTEGER 2
                }
                DESCRIPTION "Unroll the River Scroll so that the Cloud Citadel, Rivertown, and Temple Island Locations are visible."
                TEACHING_TEXT "We begin by choosing our family’s home from these three locations. Each location has a Local Tradition indicated by the icon next to its name. This Local Tradition will be our Family Tradition.\n\nOur options are: Lion of the Citadel, Ox of Rivertown, or Temple Heron."
            }
            #COWfa7f9e4acc5fe05c74e67 ^"First Session Setup: Choose Names" DEF {
                EXTENDS #COW2a7a9356dd70402814e37 ^"Step"
                PROPERTIES {
                    ^"Order" INTEGER 3
                }
                DESCRIPTION "For this next step, everyone will need a Notecard and something to write with.\n\nPlace the Banner for our chosen Family Tradition where everyone can see it."
                TEACHING_TEXT "This is our Tradition Banner. Choose a name for your main character from this list and write it down on your Notecard.\n\nThe names list ends with a prompt you can use to make up additional names.\n\nIf you know what pronouns you’d like for your character, add those to your Notecard as well."
            }
            #COW951f7481d031b585f0ba2 ^"First Session Setup: Mark Age" DEF {
                EXTENDS #COW2a7a9356dd70402814e37 ^"Step"
                PROPERTIES {
                    ^"Order" INTEGER 4
                }
                TEACHING_TEXT "We track our character’s age by drawing circles called Marks of Age. There is no direct correlation between the number of Marks and the exact age of a character in years. We can decide for ourselves what they mean as we play.\n\nChoose how old you would like your character to be: Child, Youth, Parent, or Elder. Add Marks to your Notecard as follows:\n\nChild- no Marks\n\nYouth- one or two Marks\n\nParent- three, four, or five Marks\n\nElder- six Marks."
            }
            #COW7c694e8f7718886acaba1 ^"First Session Setup: Make Bonds" DEF {
                EXTENDS #COW2a7a9356dd70402814e37 ^"Step"
                PROPERTIES {
                    ^"Order" INTEGER 5
                }
                TEACHING_TEXT "Our characters begin with two Bonds. A Bond represents an important relationship that helps to define your character’s role in our family.\n\nTo create a Bond, combine a prompt from the Bonds List with the name of another character and write it on your Notecard.\n\nThe prompts are organized by age, and you may only choose prompts at your age or younger.\n\nAt least one of your two Bonds must be with another main character. Your other Bond may be with a Side-Character if you wish. To create a Side-Character, choose any unused name from our Banner."
            }
            #COW03b0c061827776d6b0268 ^"First Session Setup: Hold Traditions" DEF {
                EXTENDS #COW2a7a9356dd70402814e37 ^"Step"
                PROPERTIES {
                    ^"Order" INTEGER 6
                }
                STEPS {
                    #COW4f9608b9d4b76cab0e256 ^"First Session Setup: Hold Traditions: Choose Tradition Cards" DEF {
                        EXTENDS #COW2a7a9356dd70402814e37 ^"Step"
                        PROPERTIES {
                            ^"Order" INTEGER 1
                        }
                        DESCRIPTION "Spread the cards from our family’s Tradition Deck (the Tradition we chose earlier) face-up on the table."
                        TEACHING_TEXT "Each main character begins with a Hand of Tradition Cards equal to their Marks of Age (Children begin with no Tradition Cards).\n\nHolding a Tradition might mean that this tradition is important to your character, that they exemplify this tradition, or that they are somehow obligated to uphold this tradition.\n\nEveryone can choose at once. Pick Tradition Cards that you feel drawn to. Don’t worry if you do not know what a card means when you choose it. The meaning of our traditions will naturally grow and change as we play."
                    }
                    #COW2e3efc3906438a37dd5ac ^"First Session Setup: Hold Traditions: Gather the Tradition Deck" DEF {
                        EXTENDS #COW2a7a9356dd70402814e37 ^"Step"
                        PROPERTIES {
                            ^"Order" INTEGER 2
                        }
                        DESCRIPTION "After we have chosen Tradition Cards, gather the remaining cards back into a deck and put it next to the River Scroll by our home.\n\nIt is not necessary to shuffle cards in City of Winter. Instead, let the order of cards naturally shift from session to session."
                    }
                }
            }
            #COW5abaac91e39c738b4a4d8 ^"First Session Setup: Choose Tokens" DEF {
                EXTENDS #COW2a7a9356dd70402814e37 ^"Step"
                PROPERTIES {
                    ^"Order" INTEGER 7
                }
                DESCRIPTION "Place the Tokens on the table."
                TEACHING_TEXT "Take a token to represent your character and place it on the picture of our home. The tokens have different images on each side. You can choose either side to represent your character, and even change sides during play if you like."
            }
            #COW099bdad8befd6c4558ee8 ^"First Session Setup: Introduce the Umbra" DEF {
                EXTENDS #COW2a7a9356dd70402814e37 ^"Step"
                PROPERTIES {
                    ^"Order" INTEGER 8
                }
                DESCRIPTION "Have yourself or another player read the prelude from the beginning of the River Scroll."
                TEACHING_TEXT "The Umbra is coming, and the Riverlands are no longer safe. Our family must flee to the City of Winter, to find another home."
                FOLLOW_UP "After the prelude is read, place the Umbra Deck next to the scroll and read the following:"
                TEACHING_TEXT "The Umbra represents the force that drives us from our home, and the Umbra Deck is a tool we can reach for when we want to introduce pressure or adversity into our story.\n\nIt is up to us to decide exactly what the Umbra is, and how big of a role the Umbra takes in our story as we play."
            }
        }
    }

    #COWee1ad0eb29854c6f9a454 ^"Tradition Scene" DEF {
        EXTENDS #COWdd203f5d990a61b496a78 ^"Procedure"
        PROPERTIES {
            ^"Phase" STRING "Playing the Game"
            ^"Page" INTEGER 21
        }
        DESCRIPTION "On your turn do the following:"
        STEPS {
            #COW810fe4d476e665b537a0d ^"Tradition Scene: Choose a Scene" DEF {
                EXTENDS #COW2a7a9356dd70402814e37 ^"Step"
                PROPERTIES {
                    ^"Order" INTEGER 1
                }
                DESCRIPTION "Each location has several prompts called Scenes. On your turn, move your token to a scene at our family’s current location. You may choose any scene, even if another player’s token is already there."
            }
            #COW4022b7dc11f88818bc3a5 ^"Tradition Scene: Share or witness?" DEF {
                EXTENDS #COW2a7a9356dd70402814e37 ^"Step"
                PROPERTIES {
                    ^"Order" INTEGER 2
                }
                DESCRIPTION "During this scene, your character will either share or witness a Tradition. Choose one of the following two options and follow the instructions:"
                OPTION ^"Share a Tradition" {
                    DESCRIPTION "Play a card from your hand, face down onto the table. (You must have at least one card in hand to choose this option.)"
                }
                OPTION ^"Witness a Tradition" {
                    DESCRIPTION "Draw a card from either the Umbra Deck or the Local Tradition Deck (indicated by the icon next to our current location) and without looking at it, give it to another player who privately reads the prompt on the card."
                }
            }
            #COWaec45b16ff6d399f17d0c ^"Tradition Scene: Lead the scene" DEF {
                EXTENDS #COW2a7a9356dd70402814e37 ^"Step"
                PROPERTIES {
                    ^"Order" INTEGER 3
                }
                DESCRIPTION "Describe where we are, who is there, and what is going on right now. As the scene continues, the rest of us may listen, ask questions, offer suggestions, and act out other characters."
            }
            #COW85100263bf6983d63b369 ^"Tradition Scene: Pass on the Tradition" DEF {
                EXTENDS #COW2a7a9356dd70402814e37 ^"Step"
                PROPERTIES {
                    ^"Order" INTEGER 4
                }
                DESCRIPTION "Before the end of the scene, we use the chosen Tradition Card to describe how a tradition is either shared or witnessed by your character."
                OPTION ^"Share the Tradition" {
                    DESCRIPTION "If you chose to Share a Tradition, use the prompt on your card to describe how you share a tradition with another player’s character and pass them the Card to add to their Hand."
                }
                OPTION ^"Witness the Tradition" {
                    DESCRIPTION "If you are the player who has been given the Tradition Card, it is your job to look for opportunities to introduce this tradition into the scene.\n\nInstead of roleplaying your character, roleplay as the the locals who practice this tradition. You can just describe what the people around us are doing, or, if you like, use a Banner to make up a new Side-Character.\n\nDon’t be in a hurry. Let the scene unfold on its own, and when you’re ready, jump in and describe how the tradition is witnessed in the scene. When you are done, pass the Card to the player whose turn it is. They add it to their hand."
                }
            }
            #COW2c348b9612c93ee9fa014 ^"Tradition Scene: End the Scene" DEF {
                EXTENDS #COW2a7a9356dd70402814e37 ^"Step"
                PROPERTIES {
                    ^"Order" INTEGER 5
                }
                DESCRIPTION "When you (the player who’s turn it is) are ready for your scene to end, let the group know. It’s now the next player’s turn."
            }
        }
    }

    #COW23007b859033df7df0b5f ^"Migration Scene" DEF {
        EXTENDS #COWdd203f5d990a61b496a78 ^"Procedure"
        PROPERTIES {
            ^"Phase" STRING "Playing the Game"
            ^"Page" INTEGER 24
        }
        DESCRIPTION "Migration is when our family moves to another Location, which becomes our new Home.\n\nAt the start of your turn, if your token is already on a Scene, you may choose to play a Migration Scene. After each player has had a Migration Scene, we Migrate the Family as a group.\n\nTo play a Migration Scene, do the following:"
        STEPS {
            #COW3927e4359063de0619826 ^"Migration Scene: Why You Must Leave" DEF {
                EXTENDS #COW2a7a9356dd70402814e37 ^"Step"
                PROPERTIES {
                    ^"Order" INTEGER 1
                }
                DESCRIPTION "Place your Token on your Notecard and describe why your character knows it is time to leave."
            }
            #COWca739bd0ac8bd1ce20659 ^"Migration Scene: What You Carry" DEF {
                EXTENDS #COW2a7a9356dd70402814e37 ^"Step"
                PROPERTIES {
                    ^"Order" INTEGER 2
                }
                DESCRIPTION "If you hold more Tradition Cards than Marks of Age, decide which you will carry on the journey, and place the extras face-up on the table in front of you. These cards will remain here for now."
            }
            #COWc79c64a1a8b692a79c4d7 ^"Migration Scene: Pass the turn" DEF {
                EXTENDS #COW2a7a9356dd70402814e37 ^"Step"
                PROPERTIES {
                    ^"Order" INTEGER 3
                }
                DESCRIPTION "When you are done, pass the turn. You are removed from the turn order until the rest of the players have also had their Migration Scenes. While you wait, you may still participate in other players’ turns as your main character or side-characters."
            }
        }
    }

    #COWf536cfa3e835f947b7d54 ^"Migrate the Family" DEF {
        EXTENDS #COWdd203f5d990a61b496a78 ^"Procedure"
        PROPERTIES {
            ^"Phase" STRING "Playing the Game"
            ^"Page" INTEGER 25
        }
        DESCRIPTION "After each player has had a Migration Scene, we Migrate the Family as a group."
        STEPS {
            #COWe5e36c527360c1f4f3e81 ^"Migrate the Family: Choose a destination" DEF {
                EXTENDS #COW2a7a9356dd70402814e37 ^"Step"
                PROPERTIES {
                    ^"Order" INTEGER 1
                }
                DESCRIPTION "We decide our destination together. We may travel to any location that is connected by a river or other path to our current location."
            }
            #COWd4069d907011592ec4d8a ^"Migrate the Family: What is saved" DEF {
                EXTENDS #COW2a7a9356dd70402814e37 ^"Step"
                PROPERTIES {
                    ^"Order" INTEGER 2
                }
                DESCRIPTION "If any players hold fewer cards than their character’s Marks of Age, they should look through the face-up cards that have been left behind by other players. Select cards until they hold an equivalent number to their Marks of Age. Describe how they save or preserve these traditions."
            }
            #COWdf042c344932c3ec3dae3 ^"Migrate the Family: What is Left" DEF {
                EXTENDS #COW2a7a9356dd70402814e37 ^"Step"
                PROPERTIES {
                    ^"Order" INTEGER 3
                }
                DESCRIPTION "If unclaimed cards remain, for each remaining card, one of us must describe how this Tradition is left behind, forgotten, or practiced for the last time and discard that card.\n\n(Discarded Tradition Cards go to the bottom of their respective Tradition Decks.)"
            }
            #COWab1dbfbcc97773e95ae04 ^"Migrate the Family: Migrate the family" DEF {
                EXTENDS #COW2a7a9356dd70402814e37 ^"Step"
                PROPERTIES {
                    ^"Order" INTEGER 4
                }
                DESCRIPTION "Everyone now places their token on our destination. This becomes our new Home. There are icons next to the location names that tell us the Local Tradition. Bring this Tradition Deck and Banner into play (if it is not in play already).\n\nAny player may resume play by taking the first turn in our new location."
            }
        }
    }

    #COWd9ba4e8fd6962611acdff ^"Ending a Chapter" DEF {
        EXTENDS #COWdd203f5d990a61b496a78 ^"Procedure"
        PROPERTIES {
            ^"Phase" STRING "Playing the Game"
            ^"Page" INTEGER 26
        }
        DESCRIPTION "At the end of each Chapter, time passes and our characters grow older.\n\nWe might end a Chapter when we near the end of our planned session, or when we reach a point in our story where we want to skip ahead in time.\n\nWhen we’ve agreed to bring our current Chapter to a close, do the following:"
        STEPS {
            #COW90eac3b6dfd9eaae4616c ^"Ending a Chapter: Mark Age" DEF {
                EXTENDS #COW2a7a9356dd70402814e37 ^"Step"
                PROPERTIES {
                    ^"Order" INTEGER 1
                }
                DESCRIPTION "Each player adds a Mark to their character’s Notecard.\n\nIf your character is an Elder, (six Marks of Age) cross off a Mark rather than adding a Mark."
            }
            #COW4cc2bbe9c3ed655f060ed ^"Ending a Chapter: New Bonds" DEF {
                EXTENDS #COW2a7a9356dd70402814e37 ^"Step"
                PROPERTIES {
                    ^"Order" INTEGER 2
                }
                DESCRIPTION "When your character gains a Mark, make a Bond. You may use names from our Family Tradition Banners, or any other Banner matching a Tradition Card that you hold."
            }
            #COWf545fbeac5cf5c20a8a5a ^"Ending a Chapter: Hold Traditions" DEF {
                EXTENDS #COW2a7a9356dd70402814e37 ^"Step"
                PROPERTIES {
                    ^"Order" INTEGER 3
                }
                DESCRIPTION "If you hold more cards than Marks of Age, choose which you would like to carry, and place the extras face-up at the center of the table.\n\nIf you hold fewer cards than Marks of Age, you may fill up your hand with any of the face-up cards.\n\nRemaining cards are discarded."
            }
            #COWddde1a92f31158de23e99 ^"Ending a Chapter: New Chapter or End the session?" DEF {
                EXTENDS #COW2a7a9356dd70402814e37 ^"Step"
                PROPERTIES {
                    ^"Order" INTEGER 4
                }
                DESCRIPTION "After closing a Chapter, we may begin a new Chapter if we wish. Otherwise, we end the session with a closing reflection."
                OPTION ^"Start a New Chapter" {
                    DESCRIPTION "To start a new Chapter, everyone places their Token on our Home. Any player may take the first turn, then play continues clockwise as usual."
                }
                OPTION ^"Closing Reflection" {
                    DESCRIPTION "Go around the circle and give each player space to reflect on their experience.\n\nSome things to consider sharing:\n\n- A moment you enjoyed\n\n- How you are feeling right now\n\n- An appreciation of another player\n\n- Something you found challenging or difficult\n\n- A moment of silence"
                }
            }
        }
    }

    #COW2ab92e6d5e0879f0ffdb5 ^"New Session Setup" DEF {
        EXTENDS #COWdd203f5d990a61b496a78 ^"Procedure"
        PROPERTIES {
            ^"Phase" STRING "Campaign Rules"
            ^"Page" INTEGER 31
        }
        DESCRIPTION "To start a new session in an ongoing Campaign, do the following:"
        STEPS {
            #COW8015bc61e879feaaa4a1d ^"New Session Setup: Distribute Materials" DEF {
                EXTENDS #COW2a7a9356dd70402814e37 ^"Step"
                PROPERTIES {
                    ^"Order" INTEGER 1
                }
                DESCRIPTION "Distribute the Character Notecards and Tradition Cards saved from the previous Session."
            }
            #COW3f4e348ebf31e832d9df1 ^"New Session Setup: Place Tokens" DEF {
                EXTENDS #COW2a7a9356dd70402814e37 ^"Step"
                PROPERTIES {
                    ^"Order" INTEGER 2
                }
                DESCRIPTION "Place the Tokens on the Location that was our Home in the previous Chapter."
            }
            #COW8b3d622ca5739541acc78 ^"New Session Setup: Start a New Chapter" DEF {
                EXTENDS #COW2a7a9356dd70402814e37 ^"Step"
                PROPERTIES {
                    ^"Order" INTEGER 3
                }
                DESCRIPTION "Any player may take the first turn, then play continues clockwise as usual. (See Death & Memory and Birth for additional, beginning-of-Chapter steps.)"
            }
        }
    }

    #COW65682771d95ddb8ec54b2 ^"When You Die" DEF {
        EXTENDS #COWdd203f5d990a61b496a78 ^"Procedure"
        PROPERTIES {
            ^"Phase" STRING "Campaign Rules"
            ^"Page" INTEGER 32
        }
        DESCRIPTION "If your character is an Elder (has 6 Marks), roll the Die at the start of each new Chapter.\n\nIf your roll is equal to or less than the crossed-off Marks, your character has died of old age and becomes a Memory.\n\nWhen your character dies, do the following:"
        STEPS {
            #COWfd2beb1ba7ba7a437da03 ^"When You Die: Remove your Token from play" DEF {
                EXTENDS #COW2a7a9356dd70402814e37 ^"Step"
                PROPERTIES {
                    ^"Order" INTEGER 1
                }
                DESCRIPTION "Remove your token and return it to the box."
            }
            #COWcb68f2e2150321061ea09 ^"When You Die: Make a Memory Bond" DEF {
                EXTENDS #COW2a7a9356dd70402814e37 ^"Step"
                PROPERTIES {
                    ^"Order" INTEGER 2
                }
                DESCRIPTION "Make a final bond using this list:"
            }
        }
    }

    #COW8c55810b539d819e4431c ^"Memory Scene" DEF {
        EXTENDS #COWdd203f5d990a61b496a78 ^"Procedure"
        PROPERTIES {
            ^"Phase" STRING "Campaign Rules"
            ^"Page" INTEGER 32
        }
        DESCRIPTION "For the rest of the Chapter you will play as our family’s memory of your character.\n\nA character who is a Memory does not participate in the Migration Scene procedure or in another character’s Share a Tradition Scene.\n\nOtherwise, continue to participate fully in other players’ turns, offering suggestions and playing side characters, or roleplaying a tradition in a Witness a Tradition Scene, as normal.\n\nOn your turn, follow the Memory Scene procedure."
        STEPS {
            #COW8175c65bebe33d10cdf00 ^"Memory Scene: Move another Player’s Token" DEF {
                EXTENDS #COW2a7a9356dd70402814e37 ^"Step"
                PROPERTIES {
                    ^"Order" INTEGER 1
                }
                DESCRIPTION "Move another character’s Token to any scene they would normally have access to."
            }
            #COW7e4dacfa75c2a91d006c5 ^"Memory Scene: Share a Tradition" DEF {
                EXTENDS #COW2a7a9356dd70402814e37 ^"Step"
                PROPERTIES {
                    ^"Order" INTEGER 2
                }
                DESCRIPTION "Choose a Tradition Card to share with this player’s character, and play it face down on the table."
            }
            #COWbdb82342f8118666b60d1 ^"Memory Scene: Lead the Scene" DEF {
                EXTENDS #COW2a7a9356dd70402814e37 ^"Step"
                PROPERTIES {
                    ^"Order" INTEGER 3
                }
                DESCRIPTION "Lead the scene as you would a normal Tradition Scene, roleplaying as our memory of your character.\n\nRoleplaying a memory could include describing something that happened long ago, how things in the scene remind us of you, or perhaps cutting away from the present moment to describe something you told us in the past."
            }
            #COWce38a7d32a039bf61934d ^"Memory Scene: Share the Tradition" DEF {
                EXTENDS #COW2a7a9356dd70402814e37 ^"Step"
                PROPERTIES {
                    ^"Order" INTEGER 4
                }
                DESCRIPTION "Before the end of the scene, describe how you share your tradition and give your Tradition Card to the other player."
            }
            #COWb424c563d9921d20ca5eb ^"Memory Scene: Pass the Turn" DEF {
                EXTENDS #COW2a7a9356dd70402814e37 ^"Step"
                PROPERTIES {
                    ^"Order" INTEGER 5
                }
                DESCRIPTION "When you are ready for the scene to end. Let the group know, and pass the turn."
            }
        }
    }

    #COW28b2afcf10a8994ce0e81 ^"Birth" DEF {
        EXTENDS #COWdd203f5d990a61b496a78 ^"Procedure"
        PROPERTIES {
            ^"Phase" STRING "Campaign Rules"
            ^"Page" INTEGER 34
        }
        DESCRIPTION "At the start of a new Chapter, if your character is a Memory or if you are a new player joining an existing campaign, follow these rules to make a new character:"
        STEPS {
            #COW0e7b1e04cc8b9dfc1e8e4 ^"Birth: Choose another player" DEF {
                EXTENDS #COW2a7a9356dd70402814e37 ^"Step"
                PROPERTIES {
                    ^"Order" INTEGER 1
                }
                DESCRIPTION "Choose another player."
            }
            #COWef54904294ac906d1d948 ^"Birth: Receive a name" DEF {
                EXTENDS #COW2a7a9356dd70402814e37 ^"Step"
                PROPERTIES {
                    ^"Order" INTEGER 2
                }
                DESCRIPTION "That player gives you a name. Write the name they give you on your Notecard."
            }
            #COWd6478c1eeff4daf816829 ^"Birth: Receive a Bond" DEF {
                EXTENDS #COW2a7a9356dd70402814e37 ^"Step"
                PROPERTIES {
                    ^"Order" INTEGER 3
                }
                DESCRIPTION "The player you chose gives you a Child Bond with their character. Write down the bond they give you on your Notecard."
            }
            #COW4eaaac6ef2ae32a70db60 ^"Birth: Choose a Token" DEF {
                EXTENDS #COW2a7a9356dd70402814e37 ^"Step"
                PROPERTIES {
                    ^"Order" INTEGER 4
                }
                DESCRIPTION "Choose from any of the remaining Tokens to represent your character, and place it on our family’s Home."
            }
        }
    }

    #COWf8c329dee6033fc754a98 ^"Migrating to the City" DEF {
        EXTENDS #COWdd203f5d990a61b496a78 ^"Procedure"
        PROPERTIES {
            ^"Phase" STRING "City Rules"
            ^"Page" INTEGER 37
        }
        DESCRIPTION "Migrating to the City introduces new rules, Traditions, and an entirely different map.\n\nThere are five entrances to the City of Winter. When we Migrate The Family to one of those entrances, we do the following:"
        STEPS {
            #COW48d5d67855038df7513d5 ^"Migrating to the City: Remove the River Scroll" DEF {
                EXTENDS #COW2a7a9356dd70402814e37 ^"Step"
                PROPERTIES {
                    ^"Order" INTEGER 1
                }
                DESCRIPTION "Roll up the River Scroll and return it to the box."
            }
            #COW42e49d46058fc56714dc3 ^"Migrating to the City: Remove the Umbra Deck" DEF {
                EXTENDS #COW2a7a9356dd70402814e37 ^"Step"
                PROPERTIES {
                    ^"Order" INTEGER 2
                }
                DESCRIPTION "Return the Umbra Deck to the box. If a player is holding an Umbra Tradition they may continue to do so."
            }
            #COW6e0e8fd0bf69bcf744d5e ^"Migrating to the City: Open the City Map" DEF {
                EXTENDS #COW2a7a9356dd70402814e37 ^"Step"
                PROPERTIES {
                    ^"Order" INTEGER 3
                }
                DESCRIPTION "Unfold the City Map, and place our tokens on the location that corresponds to our Entrance. This becomes our new Home."
            }
        }
    }

    #COW7539a19476269ba4e60f2 ^"Ask Fate" DEF {
        EXTENDS #COWdd203f5d990a61b496a78 ^"Procedure"
        PROPERTIES {
            ^"Phase" STRING "Design Notes"
            ^"Page" INTEGER 47
        }
        DESCRIPTION "When a question arises that no one wants to answer, ask Fate."
        STEPS {
            #COWa02e53d18cc0af3a63953 ^"Ask Fate: Ask Fate" DEF {
                EXTENDS #COW2a7a9356dd70402814e37 ^"Step"
                PROPERTIES {
                    ^"Order" INTEGER 1
                }
                DESCRIPTION "Pick up the die and ask the question you want Fate to answer."
            }
            #COWe3962a7abed469f30527e ^"Ask Fate: Set Outcomes" DEF {
                EXTENDS #COW2a7a9356dd70402814e37 ^"Step"
                PROPERTIES {
                    ^"Order" INTEGER 2
                }
                DESCRIPTION "As a group, agree to a likely, an unlikely, and a fateful outcome.\n\nA likely outcome is the obvious result of things as they stand.\n\nAn unlikely outcome is something that could happen, but is improbable.\n\nA fateful outcome might involve strange fortune, outside intervention, magical transformation, or new perspective."
            }
            #COW92f437960f53ca62b46fd ^"Ask Fate: Fate Answers" DEF {
                EXTENDS #COW2a7a9356dd70402814e37 ^"Step"
                PROPERTIES {
                    ^"Order" INTEGER 3
                }
                DESCRIPTION "Roll the die and describe the result:\n\n1-3 The likely outcome\n\n4-5 The unlikely outcome\n\n6 The fateful outcome"
            }
        }
    }


    # ====================================================================
    # RULES
    # ====================================================================

    #COWf0da6ea64920435ce5144 ^"Witnessing in the City" DEF {
        EXTENDS #COW739d7d78413a091e8523c ^"Rule"
        PROPERTIES {
            ^"Phase" STRING "City Rules"
            ^"Page" INTEGER 38
        }
        DESCRIPTION "Most Locations in the City have multiple Local Traditions.\n\nWhen you Witness a Tradition in the City, draw one Tradition Card for each Local Tradition icon, and give all of the cards you have drawn to one other player."
    }

    #COW803793f7d22543f8fdb59 ^"Blank Tradition Icons" DEF {
        EXTENDS #COW739d7d78413a091e8523c ^"Rule"
        PROPERTIES {
            ^"Phase" STRING "City Rules"
            ^"Page" INTEGER 38
        }
        DESCRIPTION "In the City, some Local Tradition icons are just blank shapes with no image. A blank icon means that each time you would draw a Tradition Card, you may choose from any of the Tradition Decks with the matching shape."
    }

    #COW9bd58f024f11b0b13cd08 ^"During a scene" DEF {
        EXTENDS #COW739d7d78413a091e8523c ^"Rule"
        PROPERTIES {
            ^"Phase" STRING "City Rules"
            ^"Page" INTEGER 39
        }
        DESCRIPTION "During a Witness Scene, If you are the player who received the Tradition Cards, you may now do any of the following:\n\n- Play one Tradition Card and ignore the rest.\n\n- Play one card first, and then later in the scene decide to play more.\n\n- Play multiple cards together, combining prompts to describe how these Traditions have combined to create something new.\n\nRegardless of how many Traditions you play, only pass one Tradition Card to the player whose turn it is. The rest are discarded to the bottom of their respective decks."
    }

    #COW3f35af2ba09d334432e55 ^"City Bonds" DEF {
        EXTENDS #COW739d7d78413a091e8523c ^"Rule"
        PROPERTIES {
            ^"Phase" STRING "City Rules"
            ^"Page" INTEGER 41
        }
        DESCRIPTION "If your character has at least one City Mark, you may alternately choose a prompt from the City Bonds list when making a Bond.\n\nA City Bond represents a relationship that defines who you are and what your role is in the City.\n\nJust like the regular Bonds List, the prompts are organized by number of Marks, and you may only choose from a list that has the same or fewer number of City Marks as your character."
    }

    #COW89ad0c650c2193a38286c ^"Transit Lines & Stations" DEF {
        EXTENDS #COW739d7d78413a091e8523c ^"Rule"
        PROPERTIES {
            ^"Phase" STRING "City Rules"
            ^"Page" INTEGER 42
        }
        DESCRIPTION "Every Location has a Transit Station that is connected to one or more Transit Lines. On your turn, whenever you Choose a Scene, you have the option to Travel to another Location."
    }

    #COW1499bac9a9bd5ab52cb2d ^"Travel" DEF {
        EXTENDS #COW739d7d78413a091e8523c ^"Rule"
        PROPERTIES {
            ^"Phase" STRING "City Rules"
            ^"Page" INTEGER 42
        }
        DESCRIPTION "To Travel, pick up your token and describe your character’s journey. Then place your token on any Scene at your destination, and continue your turn as normal.\n\nThe total number of Stations a character can travel from Home is equal to that character’s City Marks. You may change from one Line to another mid-journey, but each change adds one to the total City Marks required for the journey.\n\nTraveling distance is always measured from Home, even if a character’s Token is on another Location at the start of the turn.\n\nYou may include other family members in scenes at a visited location, even if they couldn’t make it there on their own."
    }

    #COWd199b3b5bec75d3590fb3 ^"Migration in the City" DEF {
        EXTENDS #COW739d7d78413a091e8523c ^"Rule"
        PROPERTIES {
            ^"Phase" STRING "City Rules"
            ^"Page" INTEGER 43
        }
        DESCRIPTION "When we Migrate The Family, we may always choose an adjacent Location as our destination. In addition, we may Migrate to any Location that one of the migrating family members could reach through Travel with their City Marks."
    }

    #COW53f9c467842659b045a58 ^"Migrate apart" DEF {
        EXTENDS #COW739d7d78413a091e8523c ^"Rule"
        PROPERTIES {
            ^"Phase" STRING "City Rules"
            ^"Page" INTEGER 43
        }
        DESCRIPTION "After you’ve had your Migration Scene, you may choose to Migrate Apart instead of skipping a future turn. Characters who have also had their Migration Scene may join you if they wish. Follow the rest of the Migrate the Family procedure with the characters who chose to Migrate Apart.\n\nCharacters who are staying may Save Traditions left by characters who are leaving."
    }

    #COW8cef6be761d90b3fdcada ^"The Wandering Borough" DEF {
        EXTENDS #COW739d7d78413a091e8523c ^"Rule"
        PROPERTIES {
            ^"Phase" STRING "City Rules"
            ^"Page" INTEGER 44
        }
        DESCRIPTION "The Wandering Borough is a special location that appears during a session when “The Borough Wanders” card is drawn and revealed from a Tradition Deck."
    }

    #COWbfd85614a4d58e616703b ^"The Borough Wanders" DEF {
        EXTENDS #COW739d7d78413a091e8523c ^"Rule"
        PROPERTIES {
            ^"Phase" STRING "City Rules"
            ^"Page" INTEGER 44
        }
        DESCRIPTION "There is one copy of “The Borough Wanders” card in each of the City (diamond-bordered) Tradition Decks.\n\nDuring a scene, we treat this card like a normal Tradition prompt, using it to inspire a description of the arrival of the Borough.\n\nAt the end of the scene, instead of passing the card to another player, discard it to the bottom of its deck. Place the Wandering Borough Location Card next to the edge of the map near where the scene took place. (You can put it on the map if you like, but you might have to move it if it gets in the way.)"
    }

    #COW75e4717422b4dd7edced1 ^"The Borough Leaves" DEF {
        EXTENDS #COW739d7d78413a091e8523c ^"Rule"
        PROPERTIES {
            ^"Phase" STRING "City Rules"
            ^"Page" INTEGER 44
        }
        DESCRIPTION "If “The Borough Wanders” card is drawn while the Borough is already in play, the Borough now leaves. The player must describe the Borough departing at some point during the scene and then remove it from play. Any visiting character tokens are returned to their home.\n\nRemove the Wandering Borough from play at the end of a Chapter (unless a character has made it their Home)."
    }

    #COW0153879f0423a5c12ee8b ^"Transit and The Borough" DEF {
        EXTENDS #COW739d7d78413a091e8523c ^"Rule"
        PROPERTIES {
            ^"Phase" STRING "City Rules"
            ^"Page" INTEGER 45
        }
        DESCRIPTION "The Borough occupies the same Station in the Transit Line as the Location where it appeared. Any character who could interact with that Location, may interact in the same way with the Wandering Borough and its Scenes."
    }

    #COW19c78a942295c6cb68d36 ^"Living on the Borough" DEF {
        EXTENDS #COW739d7d78413a091e8523c ^"Rule"
        PROPERTIES {
            ^"Phase" STRING "City Rules"
            ^"Page" INTEGER 45
        }
        DESCRIPTION "If The Wandering Borough is home to one of our characters, it remains in play from Chapter to Chapter.\n\nAt the start of each Chapter, and whenever “The Borough Wanders” card is drawn, roll the Die and consult the table below:\n\n1. Lantern Wall\n\n2. Smoke Street\n\n3. Ruin Street\n\n4. Spire Road\n\n5. In the Pull\n\n6. Moon Path\n\nChoose any location along the rolled Transit Line to be the Wandering Borough’s new Location, and place it near that Location."
    }

    #COW26be96e204d747c0af85e ^"Starting a New Chapter" DEF {
        EXTENDS #COW739d7d78413a091e8523c ^"Rule"
        PROPERTIES {
            ^"Phase" STRING "Playing the Game"
            ^"Page" INTEGER 21
        }
        DESCRIPTION "City of Winter is played in Chapters. During a Chapter, we take turns leading the group in a Tradition Scene. To start a new Chapter, decide who will go first then continue taking turns, clockwise."
    }

    #COWdd1bfd965d0276615ba76 ^"Starting a Campaign" DEF {
        EXTENDS #COW739d7d78413a091e8523c ^"Rule"
        PROPERTIES {
            ^"Phase" STRING "Campaign Rules"
            ^"Page" INTEGER 31
        }
        DESCRIPTION "A Campaign is the fullest way to experience City of Winter. You can start a Campaign by planning in advance, or evolve a one-shot into a Campaign by simply playing more Sessions.\n\nEight or more Sessions will give you a very full experience of City of Winter, though you can go much longer. Decide the number of sessions in advance, or play an open-ended campaign with no set limit.\n\nYou can also play a mini campaign with a group of friends over one long play session, or maybe over a weekend. If you fit in two or three chapters each day you should, be able to make it to the City and see a fair amount of the game."
    }

    #COW80ab1b63c695e238dd62c ^"Storing the Game" DEF {
        EXTENDS #COW739d7d78413a091e8523c ^"Rule"
        PROPERTIES {
            ^"Phase" STRING "Campaign Rules"
            ^"Page" INTEGER 31
        }
        DESCRIPTION "Between sessions of play, store each character’s Tradition Cards next to that character’s Notecard in the box between sessions of play.\n\nTo store the City Map, fold it in half twice (hamburger-style), then fold it into thirds.\n\nTo store the River Scroll, let it hang down verticaly as you roll it up by twisting the ends of the dowel. Then, wrap the cord twice and tuck the end into the wrapping."
    }

    #COW31b59e6292f5559e36a1f ^"Becoming forgotten" DEF {
        EXTENDS #COW739d7d78413a091e8523c ^"Rule"
        PROPERTIES {
            ^"Phase" STRING "Campaign Rules"
            ^"Page" INTEGER 33
        }
        DESCRIPTION "When you have shared your last Tradition Card, remove your Notecard from play. You may no longer take turns.\n\nAt the start of the next Chapter, follow the Birth rules to create a new character."
    }

    #COWb5d0482b09d17a27174fb ^"Starting in the City" DEF {
        EXTENDS #COW739d7d78413a091e8523c ^"Rule"
        PROPERTIES {
            ^"Phase" STRING "Design Notes"
            ^"Page" INTEGER 52
        }
        DESCRIPTION "Choose your Home & Tradition from of the following options:\n\nMoonbee of the Palace of the Moon\n\nFox of the Refuge\n\nBrass Ones of Lantern Gate\n\nGlowdog of the Dust\n\nCrow of the Drift\n\nMask Maker of the Wandering Borough"
    }


    # ====================================================================
    # ASK FATE — outcome table
    # ====================================================================

    #COW61d773fe08183a976de64 ^"Fate Answers" DEF {
        EXTENDS #COW739d7d78413a091e8523c ^"Rule"
        PROPERTIES {
            ^"Phase" STRING "Design Notes"
            ^"Page" INTEGER 47
        }
        OUTCOMES {
            ^"The likely outcome" DEF {
                ^"Roll" STRING "1-3"
                ^"Definition" STRING "A likely outcome is the obvious result of things as they stand."
            }
            ^"The unlikely outcome" DEF {
                ^"Roll" STRING "4-5"
                ^"Definition" STRING "An unlikely outcome is something that could happen, but is improbable."
            }
            ^"The fateful outcome" DEF {
                ^"Roll" STRING "6"
                ^"Definition" STRING "A fateful outcome might involve strange fortune, outside intervention, magical transformation, or new perspective."
            }
        }
    }


    # ====================================================================
    # SOLO PLAY — journal modules
    # ====================================================================

    #COWb02ce9a730436496f8ae8 ^"Index Module" DEF {
        EXTENDS #COW739d7d78413a091e8523c ^"Rule"
        PROPERTIES {
            ^"Phase" STRING "Design Notes"
            ^"Page" INTEGER 48
        }
        DESCRIPTION "The index is where you will track the information in your journal. To create your index, write index on the top left of the first page and first full spread of your journal."
    }

    #COWc15f03954398235e07d0e ^"Main Character Module" DEF {
        EXTENDS #COW739d7d78413a091e8523c ^"Rule"
        PROPERTIES {
            ^"Phase" STRING "Design Notes"
            ^"Page" INTEGER 49
        }
        DESCRIPTION "A Main Character Module is for tracking all of the information about a single main character.\n\nTo create a new main character, turn to the first available blank spread, add that character’s name as the title of the spread, and add it to your index.\n\nUse this space to record Marks of Age, Bonds, assigned token, character sketches, and any thoughts or reflections you have about the character."
    }

    #COWb4f8549f777a6a921d09e ^"Side Character Module" DEF {
        EXTENDS #COW739d7d78413a091e8523c ^"Rule"
        PROPERTIES {
            ^"Phase" STRING "Design Notes"
            ^"Page" INTEGER 50
        }
        DESCRIPTION "The Side Character Module is for information about ALL of the side characters.\n\nWhen you create a new side character, add their name to the Side Character Module. Decide how old they are, and add Marks of Age next to their name."
    }

    #COWec6d92648ff59733cb8c2 ^"Chapter Module" DEF {
        EXTENDS #COW739d7d78413a091e8523c ^"Rule"
        PROPERTIES {
            ^"Phase" STRING "Design Notes"
            ^"Page" INTEGER 51
        }
        DESCRIPTION "The Chapter module is where you will record your scenes along with notes, marginalia, sketches, or anything else you wish to add.\n\nEach Chapter gets a fresh module with the Chapter number as the title. As always, number and index as you go!"
    }


    # ====================================================================
    # OPTIONAL & VARIANT RULES
    # ====================================================================

    #COW05010937abda5a65e8e40 ^"The Umbra Follows" DEF {
        EXTENDS #COW739d7d78413a091e8523c ^"Rule"
        PROPERTIES {
            ^"Phase" STRING "Design Notes"
            ^"Page" INTEGER 53
        }
        OPTIONAL {
            DEFAULT off
            SCOPE GLOBAL
            TEXT "By default the Umbra Deck is no longer in play when we reach the City. But your group could decide that you would like it to remain."
        }
        DESCRIPTION "Include the Umbra Deck in play with the rest of the Tradition Cards. Whenever you would draw from a Tradition Deck, you may draw an Umbra card instead.\n\nBe aware that if you do this, the game will likely become more about the struggle against Umbra and less about the immigration experience."
    }

    #COW71d43a040bbc36110dea3 ^"Fleeing the City" DEF {
        EXTENDS #COW739d7d78413a091e8523c ^"Rule"
        PROPERTIES {
            ^"Phase" STRING "Design Notes"
            ^"Page" INTEGER 53
        }
        OPTIONAL {
            DEFAULT off
            SCOPE GLOBAL
            TEXT "In this variation, we reverse the migration pattern and tell the story of a family fleeing the City to escape the Umbra."
        }
        DESCRIPTION "New Prelude\n\n“The Umbra is coming, and the City of Winter is no longer safe. Our family must flee, to the Riverlands, to find another home.”\n\nEscaping the Umbra\n\nRemove the Umbra Deck from play when we reach Temple Island or Cloud Citadel.\n\nLeaving the city\n\nWe can Migrate from the City Map to the River Scroll through any of the points of entry listed on the Riverscroll.\n\nSome of the River Scroll prompts like “We board a lantern ship” imply a Riverlands to City journey, but I imagine your group can make that work through some slight narrative changes."
    }

    #COW593f9314f909dd6cdaae7 ^"Solo Play" DEF {
        EXTENDS #COW739d7d78413a091e8523c ^"Rule"
        PROPERTIES {
            ^"Phase" STRING "Design Notes"
            ^"Page" INTEGER 48
        }
        OPTIONAL {
            DEFAULT off
            SCOPE GLOBAL
            TEXT "These are rules for playing City of Winter solo. Instead of roleplaying scenes as a group, you will write scenes in a physical journal."
        }
        DESCRIPTION "Follow the normal rules of play, only instead of roleplaying scenes with a group of people, you will be writing scenes in your journal.\n\nFor each scene, choose to act as any of the main characters, moving their token and picking Tradition Cards according to the normal rules of play.\n\nBegin every scene journal entry with the name of the main character, the name of the scene you chose, and what kind of scene it is (Tradition, Migration, Memory, etc...)\n\nWhen you would Witness a Tradition, play the card onto the table and reveal it when you are ready to integrate the witnessed tradition into your scene."
    }

    #COWdcbc7fc86e41d5212d94a ^"Ask Fate (optional)" DEF {
        EXTENDS #COW739d7d78413a091e8523c ^"Rule"
        PROPERTIES {
            ^"Phase" STRING "Design Notes"
            ^"Page" INTEGER 47
        }
        OPTIONAL {
            DEFAULT off
            SCOPE GLOBAL
            TEXT "Over the last four years, I’ve explored many ways to play City of Winter. In this section, I’ve included some ideas that I think are interesting enough to share but don’t recommend as part of the first-time experience. Try them as-is, or use them to inspire your own explorations."
        }
        DESCRIPTION "When a question arises that no one wants to answer, ask Fate."
    }


